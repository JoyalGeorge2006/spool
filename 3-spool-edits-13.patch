             val mismatches = (x0 until x1).count { on.getPixel(it, y) != off.getPixel(it, y) }
             Assert.assertTrue(
                 "artwork backdrop must be identical with Blur effects on and off ($mismatches of ${x1 - x0} band pixels differ)",
