@@ -0,0 +1,55 @@
+package com.music.bitchord.ui.components
+
+import androidx.compose.runtime.Composable
+import androidx.compose.runtime.getValue
+import androidx.compose.ui.graphics.Color
+import androidx.compose.ui.graphics.luminance
+import androidx.compose.ui.unit.dp
+import androidx.lifecycle.compose.collectAsStateWithLifecycle
+import com.music.bitchord.data.settings.AppSettings
+import dev.chrisbanes.haze.HazeStyle
+import dev.chrisbanes.haze.HazeTint
+
+/**
+ * Spool's frost material, in one place so every frosted surface draws the same
+ * glass.
+ *
+ * The recipe is Haze's "regular" material - 24dp blur, the container colour
+ * carried in the material so glyphs keep their contrast on the layer that
+ * blurs - with a lighter tint: 60% on dark containers, 55% on light. That
+ * pair is the starting level from the blur study (the lightest step whose
+ * measured weakest-spot contrast still cleared the 4.5:1 text floor in the
+ * comparison render), to be confirmed against this native renderer on a real
+ * phone and tuned here if it misses.
+ *
+ * Solid fallback: the container colour at full opacity, drawn by Haze where
+ * blur cannot run, and by callers for the Blur effects switch off or below
+ * Android 12.
+ */
+object SpoolFrost {
+    const val DarkTintAlpha = 0.60f
+    const val LightTintAlpha = 0.55f
+    val BlurRadius = 24.dp
+
+    fun style(containerColor: Color): HazeStyle = HazeStyle(
+        blurRadius = BlurRadius,
+        backgroundColor = containerColor,
+        tint = HazeTint(
+            containerColor.copy(
+                alpha = if (containerColor.luminance() >= 0.5f) LightTintAlpha else DarkTintAlpha,
+            ),
+        ),
+        fallbackTint = HazeTint(containerColor),
+    )
+}
+
+/**
+ * True when the Blur effects switch (Settings - Appearance) is on and this
+ * phone can run real backdrop blur (Android 12+). Every frosted surface gates
+ * on this, so the switch and the solid fallback behave the same everywhere.
+ */
+@Composable
+fun rememberFrostEnabled(): Boolean {
+    val blurEffects by AppSettings.blurEffects.collectAsStateWithLifecycle()
+    return blurEffects && isGlassSupported()
+}
