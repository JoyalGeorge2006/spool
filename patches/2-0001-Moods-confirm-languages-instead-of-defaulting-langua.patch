From 437787c1116a5c26128190ee4891d530120e540e Mon Sep 17 00:00:00 2001
From: Instinct Agent <agent@instinct.com>
Date: Tue, 24 Nov 2026 22:40:43 +0530
Subject: [PATCH] Moods: confirm languages instead of defaulting, language
 chips, no worldwide fallback

---
 .../bitchord/data/settings/AppSettings.kt     | 19 ++++++++--
 .../ui/components/MusicRegionDialog.kt        | 28 ++++++++++++--
 app/src/main/res/values-ml/strings.xml        |  2 +
 app/src/main/res/values/strings.xml           |  2 +
 .../com/music/bitchord/data/MusicRegion.kt    | 38 ++++++++++++-------
 .../music/bitchord/data/MusicRegionTest.kt    | 29 +++++++++++---
 6 files changed, 90 insertions(+), 28 deletions(-)

diff --git a/app/src/main/java/com/music/bitchord/data/settings/AppSettings.kt b/app/src/main/java/com/music/bitchord/data/settings/AppSettings.kt
index e1de4ccc..9bdb2d0a 100644
--- a/app/src/main/java/com/music/bitchord/data/settings/AppSettings.kt
+++ b/app/src/main/java/com/music/bitchord/data/settings/AppSettings.kt
@@ -1122,6 +1122,7 @@ object AppSettings {
                 manualCountry = prefs.getString(KEY_MUSIC_COUNTRY, null)?.takeIf { it.length == 2 },
                 selected = prefs.getString(KEY_MUSIC_LANGUAGES, "").orEmpty()
                     .split(',').filter { it.isNotBlank() }.toSet(),
+                deviceLanguages = deviceLanguageIds(),
             ),
         )
         squareVideoThumbnails.value = false
@@ -1621,12 +1622,22 @@ object AppSettings {
         prefs.edit().putBoolean(KEY_MUSIC_REGION_AUTO, false).apply()
     }
 
-    /** Ticks a language on or off. The last one on stays on: an empty choice is the country's default. */
+    private fun deviceLanguageIds(): Set<String> {
+        val list = android.content.res.Resources.getSystem().configuration.locales
+        return com.music.bitchord.data.MusicRegion.idsForLocales((0 until list.size()).map { list[it] })
+    }
+
+    /**
+     * Ticks a language on or off. Choices made for other countries are kept, so
+     * switching away and back restores them. Turning the last one off leaves
+     * the country unconfirmed, which asks again instead of guessing.
+     */
     fun toggleMusicLanguage(id: String) {
         val current = musicRegion.value
-        val active = com.music.bitchord.data.MusicRegion.activeLanguages(current).map { it.id }.toSet()
-        val next = if (id in active) active - id else active + id
-        if (next.isEmpty()) return
+        val shown = com.music.bitchord.data.MusicRegion.activeLanguages(current).map { it.id }.toSet()
+        val country = com.music.bitchord.data.MusicRegion.languagesFor(com.music.bitchord.data.MusicRegion.countryOf(current)).map { it.id }.toSet()
+        val others = current.selected - country
+        val next = others + if (id in shown) shown - id else shown + id
         prefs.edit().putString(KEY_MUSIC_LANGUAGES, next.joinToString(",")).apply()
         publishMusicRegion(current.copy(selected = next))
     }
diff --git a/app/src/main/java/com/music/bitchord/ui/components/MusicRegionDialog.kt b/app/src/main/java/com/music/bitchord/ui/components/MusicRegionDialog.kt
index 5ff94f0d..05b93334 100644
--- a/app/src/main/java/com/music/bitchord/ui/components/MusicRegionDialog.kt
+++ b/app/src/main/java/com/music/bitchord/ui/components/MusicRegionDialog.kt
@@ -41,6 +41,7 @@ import java.util.Locale
 /** "India · Malayalam, Tamil" — what the Find Your Mood pill and the settings row show. */
 fun musicRegionSummary(state: MusicRegion.State, maxLanguages: Int = 3): String {
     val names = MusicRegion.activeLanguages(state).map { it.label }
+    if (names.isEmpty()) return MusicRegion.displayCountry(MusicRegion.countryOf(state))
     val shown = names.take(maxLanguages).joinToString(", ")
     val more = if (names.size > maxLanguages) " +${names.size - maxLanguages}" else ""
     return "${MusicRegion.displayCountry(MusicRegion.countryOf(state))} \u00b7 $shown$more"
@@ -133,10 +134,29 @@ fun MusicRegionDialog(
                     color = MaterialTheme.colorScheme.onSurface.copy(alpha = 0.7f),
                     modifier = Modifier.padding(start = 4.dp, top = 8.dp))
                 val active = MusicRegion.activeLanguages(state).map { it.id }.toSet()
-                Column(verticalArrangement = Arrangement.spacedBy(2.dp)) {
-                    MusicRegion.languagesFor(country).forEach { language ->
-                        MusicRegionRow(language.label, selected = language.id in active) {
-                            AppSettings.toggleMusicLanguage(language.id)
+                val offered = MusicRegion.languagesFor(country)
+                if (offered.isEmpty()) {
+                    Text(stringResource(R.string.music_region_uncovered), fontSize = 13.sp, lineHeight = 18.sp,
+                        color = MaterialTheme.colorScheme.onSurface.copy(alpha = 0.7f),
+                        modifier = Modifier.padding(horizontal = 4.dp))
+                } else {
+                    if (MusicRegion.needsConfirmation(state)) {
+                        Text(stringResource(R.string.music_region_confirm), fontSize = 13.sp, lineHeight = 18.sp,
+                            color = MaterialTheme.colorScheme.primary,
+                            modifier = Modifier.padding(horizontal = 4.dp))
+                    }
+                    @OptIn(androidx.compose.foundation.layout.ExperimentalLayoutApi::class)
+                    androidx.compose.foundation.layout.FlowRow(
+                        horizontalArrangement = Arrangement.spacedBy(8.dp),
+                        verticalArrangement = Arrangement.spacedBy(8.dp),
+                        modifier = Modifier.padding(horizontal = 4.dp),
+                    ) {
+                        offered.forEach { language ->
+                            androidx.compose.material3.FilterChip(
+                                selected = language.id in active,
+                                onClick = { AppSettings.toggleMusicLanguage(language.id) },
+                                label = { Text(language.label) },
+                            )
                         }
                     }
                 }
