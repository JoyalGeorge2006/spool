From: Instinct Agent <agent@instinct.com>
Date: Tue, 24 Nov 2026 23:44:43 +0530
Subject: [PATCH] English is a steering language when selected

---
 .../jvmSharedMain/kotlin/com/music/bitchord/data/MusicRegion.kt | 2 +-
 .../jvmTest/kotlin/com/music/bitchord/data/MusicRegionTest.kt   | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/shared/src/jvmSharedMain/kotlin/com/music/bitchord/data/MusicRegion.kt b/shared/src/jvmSharedMain/kotlin/com/music/bitchord/data/MusicRegion.kt
index 49b8c731..bc942ccd 100644
--- a/shared/src/jvmSharedMain/kotlin/com/music/bitchord/data/MusicRegion.kt
+++ b/shared/src/jvmSharedMain/kotlin/com/music/bitchord/data/MusicRegion.kt
@@ -25,7 +25,7 @@ object MusicRegion {
         id to Language(id, label, hints.toList())
 
     val languages: Map<String, Language> = linkedMapOf(
-        lang("english", "English"),
+        lang("english", "English", "english"),
         lang("malayalam", "Malayalam", "malayalam", "mollywood", "kerala"),
         lang("tamil", "Tamil", "tamil", "kollywood"),
         lang("hindi", "Hindi", "hindi", "bollywood"),
diff --git a/shared/src/jvmTest/kotlin/com/music/bitchord/data/MusicRegionTest.kt b/shared/src/jvmTest/kotlin/com/music/bitchord/data/MusicRegionTest.kt
index 47d1ef8f..47dee15c 100644
--- a/shared/src/jvmTest/kotlin/com/music/bitchord/data/MusicRegionTest.kt
+++ b/shared/src/jvmTest/kotlin/com/music/bitchord/data/MusicRegionTest.kt
@@ -44,7 +44,7 @@ class MusicRegionTest {
         assertEquals(setOf("malayalam", "english"), MusicRegion.activeLanguages(ml).map { it.id }.toSet())
         val en = india.copy(deviceLanguages = setOf("english"))
         assertEquals(listOf("english"), MusicRegion.activeLanguages(en).map { it.id })
-        assertTrue(MusicRegion.steeringLanguages(en).isEmpty())
+        assertEquals(listOf("english"), MusicRegion.steeringLanguages(en).map { it.id })
     }
 
     @Test
