+        lang("portuguese", "Portuguese", "portuguese", "brazil", "sertanejo"),
+        lang("french", "French", "french", "fran\u00e7ais"),
+        lang("german", "German", "german", "deutsch"),
+        lang("italian", "Italian", "italian", "italiano"),
